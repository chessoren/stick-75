    "How do you feel after a long scroll?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment tu te sens après un long scroll ?"
          }
        }
      }
    },
    "No wrong answer. Stick will remind you of this one.": {
