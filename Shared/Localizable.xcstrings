    "Day held. See you tonight.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jour tenu. À ce soir."
          }
        }
      }
    },
    "Take the wake-up call to set today's goals": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prends l'appel du réveil pour fixer tes objectifs du jour"
          }
        }
      }
    },
    "Goals done. Tonight's debrief closes the day.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objectifs faits. Le bilan du soir ferme la journée."
          }
        }
      }
    },
    "Call Stick now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeler Stick maintenant"
          }
        }
      }
    },
    "Today's progress": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression du jour"
          }
        }
      }
    },
    "Stick hasn't called yet. Set 1 to 3 goals for today with your own voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick n'a pas encore appelé. Fixe 1 à 3 objectifs pour aujourd'hui avec ta propre voix."
          }
        }
      }
    },
    "Every goal is done. Take the evening debrief to lock the day.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les objectifs sont faits. Prends le bilan du soir pour verrouiller la journée."
          }
        }
      }
    },
    "Next up: %@. Finish it before you touch anything else.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivant : %@. Termine-le avant de toucher à quoi que ce soit d'autre."
          }
        }
      }
    },
    "You slipped today. One lapse is fine, two is not. Take the recovery call.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as craqué aujourd'hui. Un écart, ça passe. Deux, non. Prends l'appel de reprise."
          }
        }
      }
    },
    "Add a goal": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un objectif"
          }
        }
      }
    },
