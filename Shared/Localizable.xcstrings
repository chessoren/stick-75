    },
    "Interception off · set it up": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interception désactivée · à configurer"
          }
        }
      }
    },
    "Shield is on for this act.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouclier est actif pour cet acte."
          }
        }
      }
    },
    "Shield is off for this act (15 minutes a day, on your honor). Stick still calls when an app opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouclier est levé pour cet acte (15 minutes par jour, sur l'honneur). Stick appelle toujours quand une app s'ouvre."
          }
        }
      }
    },
    "Screen Time is not connected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps d'écran n'est pas connecté."
          }
        }
      }
    },
    "Allow Screen Time to shield your apps. Without it, the Shortcuts automation still makes Stick call when an app opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Temps d'écran pour protéger tes apps. Sans ça, l'automatisation Raccourcis fait quand même appeler Stick quand une app s'ouvre."
          }
        }
      }
    },
    "Delete my account and data": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer mon compte et mes données"
          }
        }
      }
    },
    "Delete my account and data?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
