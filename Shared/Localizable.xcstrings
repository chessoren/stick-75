        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld heures récupérées. Le coffre s'ouvre."
          }
        }
      }
    },
    "“I've deleted TikTok four times. Hearing my own voice tell me to close it is the only thing that has ever worked.”": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« J'ai supprimé TikTok quatre fois. Entendre ma propre voix me dire de fermer est la seule chose qui ait jamais marché. »"
