      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'objectif."
          }
        }
      }
    },
    "Stick sets them with you on the wake-up call. Or add one by hand.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick les fixe avec toi à l'appel du réveil. Ou ajoutes-en un à la main."
          }
        }
      }
    },
