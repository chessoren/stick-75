    },
    "Push": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coup de pression"
          }
        }
      }
    },
    "Make it ring when %@ opens.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais-le sonner quand %@ s'ouvre."
          }
        }
      }
    },
    "One minute in the Shortcuts app. Without this step, nothing happens when you open %@. Do it now, not later.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une minute dans l'app Raccourcis. Sans cette étape, rien ne se passe quand tu ouvres %@. Fais-le maintenant, pas plus tard."
          }
        }
      }
    },
    "Tap \"Open Shortcuts\" below, go to the Automation tab, tap +.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche « Ouvrir Raccourcis » ci-dessous, va dans l'onglet Automatisation, touche +."
          }
        }
      }
    },
    "Choose \"App\", pick %@ (and the other apps you block), keep \"Is Opened\", select \"Run Immediately\", then Next.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis « App », sélectionne %@ (et les autres apps que tu bloques), garde « Est ouverte », sélectionne « Exécuter immédiatement », puis Suivant."
          }
        }
      }
    },
    "Search the action \"Open URLs\", tap the URL field and paste the link below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherche l'action « Ouvrir les URL », touche le champ URL et colle le lien ci-dessous."
          }
        }
      }
    },
    "Tap Done. Then open %@ once: Stick should ring.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche OK. Puis ouvre %@ une fois : Stick doit sonner."
          }
        }
      }
    },
    "Search the action \"Open URLs\", tap the URL field and paste: stick://intercept": {
      "localizations": {
        "fr": {
