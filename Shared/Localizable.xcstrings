      }
    },
    "%@, billed weekly to your Apple Account until cancelled. Cancel any time in Settings at least 24 h before renewal.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, facturé chaque semaine sur ton compte Apple jusqu'à annulation. Annule à tout moment dans Réglages, au moins 24 h avant le renouvellement."
