            "value": "L'interception est désactivée"
          }
        }
      }
    },
    "Stick can't ring when you open TikTok until the Shortcuts automation is set. One minute.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick ne peut pas sonner quand tu ouvres TikTok tant que l'automatisation Raccourcis n'est pas créée. Une minute."
          }
