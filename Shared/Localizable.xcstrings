      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimanche déconnecté"
          }
        }
      }
    },
    "24 hours without the apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "24 heures sans les apps"
          }
        }
      }
    },
    "From dinner to sleep, the phone stays in another room.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du dîner au coucher, le téléphone reste dans une autre pièce."
          }
        }
      }
    },
    "No blocked app from waking up to bed. Not even the window.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app bloquée du réveil au coucher. Même pas la fenêtre."
          }
        }
      }
    },
    "A full day, window included, without opening one of your apps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une journée entière, fenêtre comprise, sans ouvrir une de tes apps."
          }
        }
      }
    },
    "Your 75 days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes 75 jours."
          }
        }
      }
    },
    "Five acts. Stick changes at every one. So do you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinq actes. Stick change à chacun. Toi aussi."
          }
        }
      }
