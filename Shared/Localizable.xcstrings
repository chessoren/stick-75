    "The Silence starts now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Silence commence maintenant."
          }
        }
      }
    },
    "Tomorrow at %@, your voice rings for the first goals. Until then: one goal for today, right now.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demain à %@, ta voix sonne pour les premiers objectifs. D'ici là : un objectif pour aujourd'hui, tout de suite."
