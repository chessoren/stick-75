      }
    },
    "Why 75 days": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi 75 jours"
          }
        }
      }
    },
    "608 hours a year on TikTok on average. That's 25 full days.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "608 heures par an sur TikTok en moyenne. 25 jours pleins."
          }
        }
      }
    },
    "A new habit takes a median of 66 days to become automatic (Lally et al., 2010). 75 gives you margin.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle habitude met en médiane 66 jours à devenir automatique (Lally et al., 2010). 75 te laisse de la marge."
          }
        }
      }
    },
    "You can ignore a coach. Nobody ignores their own voice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux ignorer un coach. Personne n'ignore sa propre voix."
          }
        }
      }
    },
    "One-time payment of %@. Not a subscription, nothing renews.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique de %@. Pas un abonnement, rien ne se renouvelle."
          }
